NODE_ENV=production
# Debe coincidir con ProxyPass en Apache (producción actual: 5129)
PORT=5129

JWT_SECRET=generar_secreto_largo_aleatorio
JWT_REFRESH_SECRET=generar_otro_secreto_si_aplica

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=truco_user
DB_PASSWORD=
DB_NAME=truco_prod

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Orígenes CORS (sin path; /test no va aquí). También acepta CORS_ORIGINS.
CLIENT_ORIGIN=https://trucofx.com,https://www.trucofx.com

FRONTEND_URL=https://trucofx.com/test

ENABLE_DEBUG_DEALS=false
STALE_ACTIVE_PARTIDA_MINUTES=360

# Auditoría socket: logs emitCounts por acción (playCard, etc.) en PM2
SOCKET_PERF_AUDIT=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
COMMISSION_RATE=0.05
